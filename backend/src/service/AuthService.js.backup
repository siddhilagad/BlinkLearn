// src/services/AuthService.js
const db = require('../config/db');
const bcrypt = require('bcryptjs');
const nodemailer = require('nodemailer');
const crypto = require('crypto');

class AuthService {

  // ================= REGISTER =================
  async registerUser({ name, email, password, account_type }) {
    try {
      const hashedPassword = await bcrypt.hash(password, 10);
      const sql = `INSERT INTO users (name, email, password, role) VALUES (?, ?, ?, ?)`;
      const result = await new Promise((resolve, reject) => {
        db.query(sql, [name, email, hashedPassword, account_type], (err, res) => {
          if (err) return reject(err);
          resolve(res);
        });
      });
      return { success: true, message: 'Registration successful', insertId: result.insertId };
    } catch (err) {
      if (err.code === 'ER_DUP_ENTRY') {
        throw new Error('Email already exists');
      }
      throw new Error('Registration failed');
    }
  }

  // ================= LOGIN =================
  async loginUser({ email, password }) {
    try {
      const sql = `SELECT * FROM users WHERE email = ?`;
      const results = await new Promise((resolve, reject) => {
        db.query(sql, [email], (err, res) => {
          if (err) return reject(err);
          resolve(res);
        });
      });

      if (results.length === 0) throw new Error('Invalid email or password');

      const user = results[0];
      const isMatch = await bcrypt.compare(password, user.password);
      if (!isMatch) throw new Error('Invalid email or password');

      return {
        user_id: user.user_id,
        name: user.name,
        email: user.email,
        role: user.role,
      };
    } catch (err) {
      throw err;
    }
  }

  // ================= FORGOT PASSWORD =================
  async forgotPassword(email) {
    // 1. User आहे का check कर
    const user = await new Promise((resolve, reject) => {
      db.query('SELECT * FROM users WHERE email = ?', [email], (err, res) => {
        if (err) return reject(err);
        resolve(res[0]);
      });
    });

    if (!user) throw new Error('User not found');

    // 2. Token generate कर
    const token = crypto.randomBytes(32).toString('hex');
    const expiry = new Date(Date.now() + 60 * 60 * 1000); // 1 hour

    // 3. Token DB मध्ये save कर
    await new Promise((resolve, reject) => {
      db.query(
        'UPDATE users SET reset_token = ?, reset_token_expiry = ? WHERE email = ?',
        [token, expiry, email],
        (err, res) => {
          if (err) return reject(err);
          resolve(res);
        }
      );
    });

    // 4. Email पाठव
    const transporter = nodemailer.createTransport({
      host: 'smtp.gmail.com',
port: 587,
secure: false,
family: 4,
      auth: {
        user: process.env.EMAIL_USER,
        pass: process.env.EMAIL_PASS,
      },
    });

    const resetLink = `http://localhost:3000/reset-password/${token}`;

    await transporter.sendMail({
      from: `"BlinkLearn" <${process.env.EMAIL_USER}>`,
      to: email,
      subject: 'Password Reset - BlinkLearn',
      html: `
        <div style="font-family: Arial, sans-serif; max-width: 500px; margin: auto;">
          <h2 style="color: #4f46e5;">BlinkLearn — Password Reset</h2>
          <p>Hi ${user.name},</p>
          <p>Click the button below to reset your password. This link will expire in <strong>1 hour</strong>.</p>
          <a href="${resetLink}" 
             style="display: inline-block; padding: 12px 28px; background: #4f46e5; color: #fff; border-radius: 8px; text-decoration: none; font-weight: bold; margin: 16px 0;">
            Reset Password
          </a>
          <p style="color: #6b7280; font-size: 13px;">If you didn't request this, ignore this email.</p>
        </div>
      `,
    });

    return { message: 'Email sent successfully' };
  }

  // ================= RESET PASSWORD =================
  async resetPassword(token, newPassword) {
    // 1. Token valid आहे का check कर
    const user = await new Promise((resolve, reject) => {
      db.query(
        'SELECT * FROM users WHERE reset_token = ? AND reset_token_expiry > NOW()',
        [token],
        (err, res) => {
          if (err) return reject(err);
          resolve(res[0]);
        }
      );
    });

    if (!user) throw new Error('Invalid or expired token');

    // 2. नवीन password hash करा
    const hashedPassword = await bcrypt.hash(newPassword, 10);

    // 3. Password update कर, token clear कर
    await new Promise((resolve, reject) => {
      db.query(
        'UPDATE users SET password = ?, reset_token = NULL, reset_token_expiry = NULL WHERE user_id = ?',
        [hashedPassword, user.user_id],
        (err, res) => {
          if (err) return reject(err);
          resolve(res);
        }
      );
    });

    return { message: 'Password reset successfully' };
  }
}

module.exports = new AuthService();
